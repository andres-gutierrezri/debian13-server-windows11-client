# Copie a .env y ajuste. Nunca versione el archivo .env real.
SERVER_HOSTNAME=srv-debian13
DOMAIN_SUFFIX=lab.local
SERVER_IFACE=enp0s8
SERVER_IP=192.168.56.10
PREFIX=24
LAN_CIDR=192.168.56.0/24
GATEWAY=192.168.56.1
DNS=1.1.1.1
ADMIN_USER=sysadmin
SMB_GROUP=smbusers
SHARE_NAME=compartido
SHARE_PATH=/srv/samba/compartido
WORKGROUP=WORKGROUP
# true solo si desea que el script escriba la IP estatica (riesgo de perder la sesion SSH)
APPLY_NETWORK=false
# Poner en "no" unicamente DESPUES de instalar la llave publica del cliente
SSH_PASSWORD_AUTH=yes
